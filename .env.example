# Copier ce fichier en .env et remplir les valeurs. .env n'est JAMAIS commité.

# Groq : https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (plan B si Groq est saturé) : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI (embeddings BGE-M3)
# account_id : tableau de bord Cloudflare > Workers & Pages > Overview (colonne de droite)
# token : My Profile > API Tokens > Create Token > modele "Workers AI"
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Facultatif : surcharge l'architecture par defaut sans toucher au YAML (rag | graphrag)
# RAG_UHA_PIPELINE=graphrag
